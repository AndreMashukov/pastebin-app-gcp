{
  "name": "pastebin-app-gcp",
  "version": "0.1.0",
  "private": true,
  "description": "GCP port of the AWS pastebin-app (Cloud Run v2 + Firestore + Eventarc + Pub/Sub + GCS).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "show:projects": "nx show projects",
    "deploy:author-bff": "nx run author-bff:deploy",
    "deploy:public-bff": "nx run public-bff:deploy",
    "deploy:reaper": "nx run reaper:deploy",
    "deploy:bffs": "nx run-many -t deploy -p author-bff,public-bff,reaper"
  },
  "devDependencies": {
    "@nx/js": "^23.1.0",
    "@nx/workspace": "^23.1.0",
    "@types/node": "^20.11.0",
    "nx": "^23.1.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/pubsub": "^4.7.0",
    "@google-cloud/secret-manager": "^4.2.0",
    "@google-cloud/storage": "^7.12.0",
    "@hono/node-server": "^1.11.0",
    "firebase-admin": "^12.2.0",
    "hono": "^4.4.0",
    "jose": "^5.6.0",
    "protobufjs": "^7.6.5",
    "zod": "^3.23.0"
  }
}
